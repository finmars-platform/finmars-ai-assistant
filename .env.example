TZ=Europe/Luxembourg

PIPELINES_API_KEY=test

# The following static variables are for non-OIDC setups
# Do not use these vars in `docker-compose-oidc-sso-keycloak-integration.yaml`
FINMARS_SPACE=space0ihxm
FINMARS_REALM=realm0v4ry
FINMARS_BASE_URL=https://eu-central.finmars.com
FINMARS_EXPERT_TOKEN=XXX

OPENAI_API_KEY=XXX

# Langfuse (Optional)
LANGFUSE_SECRET_KEY=XXX
LANGFUSE_PUBLIC_KEY=XXX
LANGFUSE_HOST=http://localhost:3000

# or `langfuse`. (default: code)
PROMPT_SOURCE=code

ACTIVATE_PUBLIC_NAME=false

# --- OIDC SSO & Token Exchange Settings ---

# -- Domain Names --
# Main domain where the Open WebUI is accessible
MAIN_DOMAIN_NAME=XXX  # Take from finmars api services
# Authentication domain where Keycloak is hosted
AUTH_DOMAIN_NAME=XXX  # Take from finmars api services

# -- OIDC Client Secrets --
# The client secret for the 'open-webui' client in Keycloak.
# Find this in: Keycloak Admin Console > Clients > open-webui > Credentials tab.
OPENWEBUI_CLIENT_SECRET=XXX  # Secret from Keycloak OIDC-SSO